# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_from_botfather

# Rclone Configuration
RCLONE_REMOTE_NAME=gdrive
RCLONE_BASE_DIR=TorrentBot
RCLONE_CONFIG_PATH=/app/rclone.conf

# Google Drive Index (optional)
INDEX_BASE_URL=https://your-index-url.com

# Access Control (optional, comma-separated user IDs)
OWNER_IDS=

# Download Configuration
DOWNLOAD_DIR=/tmp/downloads
MAX_DOWNLOAD_SIZE=1073741824
CONCURRENT_DOWNLOADS=3

# Torrent Settings
TORRENT_TIMEOUT=3600
SEED_TIME=0

# Progress Updates
PROGRESS_UPDATE_INTERVAL=10

# Logging
LOG_LEVEL=INFO

# For Heroku, also set RCLONE_CONFIG with the full content of your rclone.conf:
# RCLONE_CONFIG="[gdrive]\ntype = drive\nclient_id = ...\n..."
