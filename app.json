{
  "name": "DirectTorrent.me Backend",
  "description": "Flask JSON API for DirectTorrent.me with libtorrent + rclone uploads and plan-aware limits.",
  "repository": "https://github.com/Monster-ZeroX/HerokuHosted",
  "stack": "heroku-22",
  "buildpacks": [
    { "url": "https://github.com/heroku/heroku-buildpack-apt" },
    { "url": "heroku/python" }
  ],
  "formation": {
    "web": {
      "quantity": 1,
      "size": "eco"
    }
  },
  "addons": [
    "heroku-postgresql:essential-0"
  ],
  "env": {
    "SECRET_KEY": {
      "description": "Secret key for Flask sessions.",
      "generator": "secret",
      "required": true
    },
    "DATABASE_URL": {
      "description": "Database URL (Heroku Postgres attaches this automatically).",
      "required": true
    },
    "APP_ROLE": {
      "description": "Set to FREE or PAID depending on the dyno role.",
      "required": true
    },
    "APP_INSTANCE": {
      "description": "Unique label for this dyno/app (e.g., directtorrent-free-1).",
      "required": false
    },
    "ALLOWED_ORIGINS": {
      "description": "Comma-separated origins for CORS (e.g., https://your-frontend.vercel.app).",
      "required": true
    },
    "MAILEROO_API_KEY": {
      "description": "Maileroo API key used to send OTP emails.",
      "required": false
    },
    "MAILEROO_SENDER": {
      "description": "Sender email for OTP messages (e.g., noreply@directtorrent.me).",
      "value": "noreply@directtorrent.me",
      "required": false
    },
    "RCLONE_CONFIG": {
      "description": "Full contents of your rclone.conf file (paste as one value).",
      "required": true
    },
    "RCLONE_CONFIG_PATH": {
      "description": "Path where the config will be written inside the dyno.",
      "value": "/app/rclone.conf",
      "required": false
    },
    "RCLONE_REMOTE_NAME": {
      "description": "Remote name from your rclone config (e.g., gdrive).",
      "value": "gdrive",
      "required": true
    },
    "RCLONE_BASE_DIR": {
      "description": "Base directory on the remote for uploads.",
      "value": "DirectTorrent",
      "required": false
    },
    "INDEX_BASE_URL": {
      "description": "Optional public index base URL for streaming links.",
      "required": false
    },
    "MEGA_EMAIL": {
      "description": "Mega.nz account email (optional).",
      "required": false
    },
    "MEGA_PASSWORD": {
      "description": "Mega.nz account password (optional).",
      "required": false
    },
    "GENIE_API_KEY": {
      "description": "Genie Business Connect API key for payments.",
      "required": false
    },
    "GENIE_MERCHANT_ID": {
      "description": "Genie merchant ID.",
      "required": false
    },
    "GENIE_API_BASE": {
      "description": "Genie API base URL.",
      "value": "https://api.geniebiz.lk/public/v2",
      "required": false
    },
    "GENIE_CREATE_PAYMENT_URL": {
      "description": "Override for Genie create-payment endpoint.",
      "required": false
    },
    "GENIE_PAYMENT_STATUS_URL": {
      "description": "Override template for Genie payment status checks.",
      "required": false
    },
    "GENIE_CURRENCY": {
      "description": "Currency code for payments.",
      "value": "LKR",
      "required": false
    },
    "PLAN_100_PRICE_LKR": {
      "description": "Price override for 100GB/day plan.",
      "value": "300",
      "required": false
    },
    "PLAN_300_PRICE_LKR": {
      "description": "Price override for 300GB/day plan.",
      "value": "600",
      "required": false
    },
    "PLAN_UNLIMITED_PRICE_LKR": {
      "description": "Price override for unlimited plan.",
      "value": "1200",
      "required": false
    }
  },
  "scripts": {
    "postdeploy": "echo 'DirectTorrent.me backend deployed.'"
  }
}
